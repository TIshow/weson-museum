---
import BaseLayout from '@layouts/BaseLayout.astro';
import { fill, localizedPath, pick, type Locale } from '@i18n/config';
import { useTranslations } from '@i18n/ui';
import { artistPath, getPublishedArtists } from '@lib/artists';
import { assetUrl } from '@lib/assets';
import {
  artistTotal,
  editionPath,
  editionTitle,
  formatPeriod,
  formatTalk,
  toJstIso,
  worldUrl,
  type Edition,
} from '@lib/artlink';

interface Props {
  lang: Locale;
  edition: Edition;
  /** 新しい順に並べたときの前後の回 */
  newer?: Edition;
  older?: Edition;
}

const { lang, edition, newer, older } = Astro.props;
const ui = useTranslations(lang);
const t = ui.artlinkEdition;
const d = edition.data;

const title = editionTitle(edition);
const period = formatPeriod(d.startDate, d.endDate, lang);
const summary = pick(d.summary, lang);
const image = assetUrl(d.image);
const world = worldUrl(edition);
const total = artistTotal(edition);

const venues = d.venues.map(venue => ({
  name: pick(venue.name, lang),
  // 会場ごとの会期は、全体の会期と違うときだけ添える
  period:
    venue.startDate && venue.endDate && (venue.startDate !== d.startDate || venue.endDate !== d.endDate)
      ? formatPeriod(venue.startDate, venue.endDate, lang)
      : undefined,
  hours: pick(venue.hours, lang),
}));

const talks = d.talks.map(talk => formatTalk(talk, lang));

// slug があっても、公開中の作家ページが無ければリンクにしない（リンク切れ防止）
const published = new Set((await getPublishedArtists()).map(a => a.id));
const artists = d.artists.map(artist => ({
  name: pick(artist.name, lang),
  href: artist.slug && published.has(artist.slug) ? artistPath(lang, artist.slug) : undefined,
}));

const records = [
  d.announcementSlug && { label: t.announcementLink, href: localizedPath(lang, `/news/${d.announcementSlug}/`) },
  d.reportSlug && { label: t.reportLink, href: localizedPath(lang, `/news/${d.reportSlug}/`) },
].filter(Boolean) as { label: string; href: string }[];

const programHref = localizedPath(lang, '/artlink/');

// ---- SEO ----
const metaDescription = summary ? `${title}（${period}）— ${summary}` : `${title} — ${period}`;
const pageUrl = new URL(editionPath(lang, edition), Astro.site).toString();
const locations = d.venues.map(venue =>
  venue.kind === 'vr'
    ? { '@type': 'VirtualLocation', ...(venue.url && { url: venue.url }), name: pick(venue.name, lang) }
    : { '@type': 'Place', name: pick(venue.name, lang) }
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ExhibitionEvent',
  name: title,
  url: pageUrl,
  ...(summary && { description: summary }),
  startDate: toJstIso(d.startDate),
  endDate: toJstIso(d.endDate, '23:59'),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode:
    d.format === 'hybrid'
      ? 'https://schema.org/MixedEventAttendanceMode'
      : 'https://schema.org/OnlineEventAttendanceMode',
  location: locations.length === 1 ? locations[0] : locations,
  ...(image && { image: new URL(image, Astro.site).toString() }),
  organizer: { '@id': 'https://weson-museum.com/#organization' },
  ...(artists.length > 0 && {
    performer: artists.map(a => ({ '@type': 'Person', name: a.name })),
  }),
  ...(d.talks.length > 0 && {
    subEvent: d.talks.map(talk => ({
      '@type': 'Event',
      name: `${title} — ${t.talks}`,
      startDate: toJstIso(talk.date, talk.start),
      endDate: toJstIso(talk.date, talk.end),
      eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
      location: locations.find(l => l['@type'] === 'VirtualLocation') ?? locations[0],
    })),
  }),
};
---

<BaseLayout title={`${title} — WESON MUSEUM`} description={metaDescription} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- ================================================================
       Hero
       ================================================================ -->
  <section class="edition-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={ui.common.breadcrumbAria}>
        <ol>
          <li><a href={localizedPath(lang, '/')}>{ui.common.home}</a></li>
          <li><a href={programHref}>ARTLINK</a></li>
          <li aria-current="page">{edition.id}</li>
        </ol>
      </nav>

      <p class="edition-eyebrow mono-label">{t.eyebrow}</p>
      <h1 class="edition-title">{title}</h1>
      <p class="edition-period">{period}</p>
      {summary && <p class="edition-summary">{summary}</p>}

      {world && (
        <div class="edition-actions">
          <a href={world} target="_blank" rel="noopener noreferrer" class="btn btn-accent">
            {t.enterButton}
          </a>
        </div>
      )}
    </div>
  </section>

  {image && (
    <div class="edition-image-wrap">
      <img src={image} alt={title} class="edition-image" loading="eager" decoding="async" />
      <div class="edition-image-overlay" aria-hidden="true"></div>
    </div>
  )}

  <!-- ================================================================
       開催概要
       ================================================================ -->
  <section class="edition-section" aria-label={title}>
    <div class="container">
      <dl class="edition-facts">
        <div class="edition-fact">
          <dt class="mono-label">{t.period}</dt>
          <dd>{period}</dd>
        </div>
        <div class="edition-fact">
          <dt class="mono-label">{t.format}</dt>
          <dd>{d.format === 'hybrid' ? t.formatHybrid : t.formatVr}</dd>
        </div>
        <div class="edition-fact">
          <dt class="mono-label">{t.venue}</dt>
          <dd>
            <ul class="edition-venues" role="list">
              {venues.map(venue => (
                <li>
                  <span class="edition-venue-name">{venue.name}</span>
                  {(venue.period || venue.hours) && (
                    <span class="edition-venue-meta">
                      {[venue.period, venue.hours].filter(Boolean).join(' / ')}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </dd>
        </div>
        {d.admission && (
          <div class="edition-fact">
            <dt class="mono-label">{t.admission}</dt>
            <dd>{pick(d.admission, lang)}</dd>
          </div>
        )}
        {talks.length > 0 && (
          <div class="edition-fact">
            <dt class="mono-label">{t.talks}</dt>
            <dd>
              <ul class="edition-talks" role="list">
                {talks.map(talk => <li>{talk}</li>)}
              </ul>
            </dd>
          </div>
        )}
        {total && (
          <div class="edition-fact">
            <dt class="mono-label">{t.artists}</dt>
            <dd>{fill(t.artistCount, { n: total })}</dd>
          </div>
        )}
        {d.organizer && (
          <div class="edition-fact">
            <dt class="mono-label">{t.organizer}</dt>
            <dd>{pick(d.organizer, lang)}</dd>
          </div>
        )}
      </dl>

      {artists.length > 0 && (
        <div class="edition-block">
          <h2 class="edition-block-heading mono-label">{t.artists}</h2>
          <ul class="edition-artist-list" role="list">
            {artists.map(artist => (
              <li>{artist.href ? <a href={artist.href}>{artist.name}</a> : <span>{artist.name}</span>}</li>
            ))}
          </ul>
        </div>
      )}

      {records.length > 0 && (
        <div class="edition-block">
          <h2 class="edition-block-heading mono-label">{t.records}</h2>
          <ul class="edition-records" role="list">
            {records.map(record => (
              <li>
                <a href={record.href} class="edition-record">
                  <span>{record.label}</span>
                  <span class="edition-record-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {d.notice && <p class="edition-notice">{pick(d.notice, lang)}</p>}
    </div>
  </section>

  <!-- ================================================================
       回の前後と、企画全体のページへの導線
       ================================================================ -->
  <nav class="edition-pager" aria-label="ARTLINK">
    <div class="container edition-pager-inner">
      <a href={programHref} class="btn btn-outline">{t.backToProgram}</a>
      <div class="edition-pager-links">
        {older && (
          <a href={editionPath(lang, older)} class="edition-pager-link">
            <span class="mono-label">← {t.previous}</span>
            <span>{editionTitle(older)}</span>
          </a>
        )}
        {newer && (
          <a href={editionPath(lang, newer)} class="edition-pager-link edition-pager-link--next">
            <span class="mono-label">{t.next} →</span>
            <span>{editionTitle(newer)}</span>
          </a>
        )}
      </div>
    </div>
  </nav>
</BaseLayout>

<style>
  .edition-hero {
    padding-block: var(--space-16) var(--space-16);
    border-bottom: 1px solid var(--color-border);
  }

  .edition-eyebrow {
    color: var(--color-accent);
    margin-bottom: var(--space-6);
  }

  .edition-title {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 200;
    letter-spacing: var(--tracking-widest);
    line-height: 1.05;
    margin-bottom: var(--space-6);
  }

  .edition-period {
    font-size: var(--text-lg);
    font-weight: 300;
    letter-spacing: var(--tracking-wide);
    color: var(--color-main);
    margin-bottom: var(--space-8);
  }

  .edition-summary {
    font-size: var(--text-base);
    line-height: 2;
    color: var(--color-text-muted);
    max-width: var(--content-width);
  }

  .edition-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }

  /* ---- Image ---- */
  .edition-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 6;
    overflow: hidden;
  }

  .edition-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.65) saturate(0.85);
  }

  .edition-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--color-bg) 0%, transparent 20%, transparent 80%, var(--color-bg) 100%);
    pointer-events: none;
  }

  /* ---- 開催概要 ---- */
  .edition-section {
    padding-block: var(--space-16) var(--space-24);
    border-bottom: 1px solid var(--color-border);
  }

  .edition-facts {
    border-top: 1px solid var(--color-border);
    max-width: var(--content-width);
  }

  .edition-fact {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .edition-fact dt {
    color: var(--color-text-muted);
  }

  .edition-fact dd {
    font-size: var(--text-sm);
    line-height: 1.8;
    color: var(--color-text);
  }

  .edition-venues,
  .edition-talks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .edition-venues li {
    display: flex;
    flex-direction: column;
  }

  .edition-venue-meta {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .edition-block {
    margin-top: var(--space-16);
    max-width: var(--content-width);
  }

  .edition-block-heading {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .edition-artist-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
  }

  .edition-artist-list li {
    font-size: var(--text-base);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text);
  }

  .edition-artist-list a {
    color: var(--color-main);
    border-bottom: 1px solid var(--color-border-bright);
  }

  .edition-artist-list a:hover {
    color: var(--color-main-light);
    border-color: var(--color-main);
  }

  .edition-records {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .edition-records li {
    border-bottom: 1px solid var(--color-border);
  }

  .edition-record {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
    color: var(--color-text);
    text-decoration: none;
  }

  .edition-record:hover {
    color: var(--color-main);
    text-decoration: none;
  }

  .edition-record-arrow {
    color: var(--color-text-muted);
    transition: transform var(--transition-fast);
  }

  .edition-record:hover .edition-record-arrow {
    transform: translateX(4px);
    color: var(--color-main);
  }

  .edition-notice {
    margin-top: var(--space-12);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  /* ---- Pager ---- */
  .edition-pager {
    padding-block: var(--space-12);
  }

  .edition-pager-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .edition-pager-links {
    display: flex;
    gap: var(--space-8);
  }

  .edition-pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--color-text);
    text-decoration: none;
  }

  .edition-pager-link:hover {
    color: var(--color-main);
    text-decoration: none;
  }

  .edition-pager-link--next {
    text-align: right;
  }

  @media (max-width: 640px) {
    .edition-hero { padding-block: var(--space-12); }
    .edition-period { font-size: var(--text-base); }
    .edition-image-wrap { aspect-ratio: 16 / 9; }
    .edition-section { padding-block: var(--space-12) var(--space-16); }
    .edition-fact { grid-template-columns: 88px 1fr; }
    .edition-block { margin-top: var(--space-12); }
  }
</style>
