---
import BaseLayout from '@layouts/BaseLayout.astro';
import { fill, localizedPath, pick, type Locale } from '@i18n/config';
import { useTranslations } from '@i18n/ui';
import { artistPath, getPublishedArtists } from '@lib/artists';
import { assetUrl } from '@lib/assets';
import {
  artistTotal,
  buildCalendar,
  dateParts,
  editionPath,
  editionTitle,
  formatPeriod,
  formatTalkTime,
  toJstIso,
  worldUrl,
  type Edition,
} from '@lib/artlink';

interface Props {
  lang: Locale;
  edition: Edition;
  /** 新しい順に並べたときの前後の回 */
  newer?: Edition;
  older?: Edition;
}

const { lang, edition, newer, older } = Astro.props;
const ui = useTranslations(lang);
const t = ui.artlinkEdition;
const d = edition.data;

const title = editionTitle(edition);
const period = formatPeriod(d.startDate, d.endDate, lang);
const summary = pick(d.summary, lang);
const image = assetUrl(d.image);
const keyVisual = d.keyVisual && { src: assetUrl(d.keyVisual.src)!, alt: pick(d.keyVisual.alt, lang) };
const talkPhoto = d.talkPhoto && { src: assetUrl(d.talkPhoto.src)!, alt: pick(d.talkPhoto.alt, lang) };
const world = worldUrl(edition);
const worldSearch = d.venues.find(v => v.kind === 'vr')?.search;
const total = artistTotal(edition);
const admission = pick(d.admission, lang);

const venues = d.venues.map(venue => ({
  name: pick(venue.name, lang),
  // 会場ごとの会期は、全体の会期と違うときだけ添える
  period:
    venue.startDate && venue.endDate && (venue.startDate !== d.startDate || venue.endDate !== d.endDate)
      ? formatPeriod(venue.startDate, venue.endDate, lang)
      : undefined,
  hours: pick(venue.hours, lang),
}));

// ---- スケジュール ----
const talks = d.talks.map(talk => {
  const p = dateParts(talk.date, lang);
  return {
    month: lang === 'ja' ? `${p.month}月` : p.monthName,
    day: p.day,
    weekday: p.weekday,
    time: formatTalkTime(talk, lang),
    label: pick(talk.label, lang) ?? t.talkLabel,
    note: pick(talk.note, lang),
    inPeriod: talk.date >= d.startDate && talk.date <= d.endDate,
    startIso: toJstIso(talk.date, talk.start),
    endIso: toJstIso(talk.date, talk.end),
    date: talk.date,
  };
});
const calendar = talks.length > 0 ? buildCalendar(edition) : [];

// ---- 参加作家（公開中の作家ページがあるときだけリンクと写真を出す） ----
const published = new Map((await getPublishedArtists()).map(a => [a.id, a]));
const artists = d.artists.map(artist => {
  const page = artist.slug ? published.get(artist.slug) : undefined;
  const name = pick(artist.name, lang);
  return {
    name,
    href: page ? artistPath(lang, page.id) : undefined,
    photo: page ? assetUrl(page.data.portrait ?? page.data.coverImage) : undefined,
    initial: Array.from(name)[0],
  };
});

const records = [
  d.announcementSlug && { label: t.announcementLink, href: localizedPath(lang, `/news/${d.announcementSlug}/`) },
  d.reportSlug && { label: t.reportLink, href: localizedPath(lang, `/news/${d.reportSlug}/`) },
].filter(Boolean) as { label: string; href: string }[];

// ページ内ナビ（中身がある節だけ）
const sections = [
  talks.length > 0 && { id: 'schedule', label: t.scheduleHeading },
  artists.length > 0 && { id: 'artists', label: t.artistsHeading },
  world && { id: 'howto', label: t.howtoHeading },
  { id: 'info', label: t.infoHeading },
].filter(Boolean) as { id: string; label: string }[];

const programHref = localizedPath(lang, '/artlink/');

// ---- SEO ----
const metaDescription = summary ? `${title}（${period}）— ${summary}` : `${title} — ${period}`;
const ogImage = keyVisual?.src ?? image;
const pageUrl = new URL(editionPath(lang, edition), Astro.site).toString();
const locations = d.venues.map(venue =>
  venue.kind === 'vr'
    ? { '@type': 'VirtualLocation', ...(venue.url && { url: venue.url }), name: pick(venue.name, lang) }
    : { '@type': 'Place', name: pick(venue.name, lang) }
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ExhibitionEvent',
  name: title,
  url: pageUrl,
  ...(summary && { description: summary }),
  startDate: toJstIso(d.startDate),
  endDate: toJstIso(d.endDate, '23:59'),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode:
    d.format === 'hybrid'
      ? 'https://schema.org/MixedEventAttendanceMode'
      : 'https://schema.org/OnlineEventAttendanceMode',
  location: locations.length === 1 ? locations[0] : locations,
  ...(ogImage && { image: new URL(ogImage, Astro.site).toString() }),
  organizer: { '@id': 'https://weson-museum.com/#organization' },
  ...(artists.length > 0 && {
    performer: artists.map(a => ({ '@type': 'Person', name: a.name })),
  }),
  ...(talks.length > 0 && {
    subEvent: talks.map(talk => ({
      '@type': 'Event',
      name: `${title} — ${talk.label}`,
      startDate: talk.startIso,
      endDate: talk.endIso,
      eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
      location: locations.find(l => l['@type'] === 'VirtualLocation') ?? locations[0],
    })),
  }),
};
---

<BaseLayout title={`${title} — WESON MUSEUM`} description={metaDescription} ogImage={ogImage} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- ================================================================
       Hero — キービジュアルがある回はポスターを切り抜かずに出す
       ================================================================ -->
  {keyVisual ? (
    <section class="edition-kv-section">
      <div class="edition-kv-frame">
        <img src={keyVisual.src} alt={keyVisual.alt} class="edition-kv" loading="eager" decoding="async" width="1536" height="864" />
      </div>
    </section>
  ) : null}

  <section class={`edition-hero${keyVisual ? ' edition-hero--with-kv' : ''}`}>
    <div class="container">
      <nav class="breadcrumb" aria-label={ui.common.breadcrumbAria}>
        <ol>
          <li><a href={localizedPath(lang, '/')}>{ui.common.home}</a></li>
          <li><a href={programHref}>ARTLINK</a></li>
          <li aria-current="page">{edition.id}</li>
        </ol>
      </nav>

      <div class="edition-hero-layout">
        <div>
          <p class="edition-eyebrow mono-label">
            <span>{t.eyebrow}</span>
            <a href={programHref} class="edition-program-link">{t.aboutProgram} →</a>
          </p>
          <h1 class="edition-title">{title}</h1>
          <p class="edition-period">{period}</p>

          <ul class="edition-chips" role="list">
            <li class="edition-chip">{d.format === 'hybrid' ? t.formatHybrid : t.formatVr}</li>
            {admission && <li class="edition-chip edition-chip--accent">{fill(t.chipAdmission, { value: admission })}</li>}
            {talks.length > 0 && <li class="edition-chip">{fill(t.chipTalks, { n: talks.length })}</li>}
            {total && <li class="edition-chip">{fill(t.chipArtists, { n: total })}</li>}
          </ul>
        </div>

        {(world || talks.length > 0) && (
          <div class="edition-hero-actions">
            {world && (
              <a href={world} target="_blank" rel="noopener noreferrer" class="btn btn-accent edition-cta">
                {t.enterButton}
              </a>
            )}
            {talks.length > 0 && <a href="#schedule" class="btn btn-outline">{t.jumpSchedule}</a>}
          </div>
        )}
      </div>

      {summary && <p class="edition-summary">{summary}</p>}
    </div>
  </section>

  {!keyVisual && image && (
    <div class="edition-image-wrap">
      <img src={image} alt={title} class="edition-image" loading="eager" decoding="async" />
      <div class="edition-image-overlay" aria-hidden="true"></div>
    </div>
  )}

  <!-- ページ内ナビ -->
  <nav class="edition-tabs" aria-label={t.sectionNavAria}>
    <ul class="container edition-tabs-list" role="list">
      {sections.map(section => (
        <li><a href={`#${section.id}`}>{section.label}</a></li>
      ))}
    </ul>
  </nav>

  <!-- ================================================================
       Schedule — 作家在廊（カレンダー + タイムテーブル）
       ================================================================ -->
  {talks.length > 0 && (
    <section id="schedule" class="edition-section" aria-labelledby="schedule-heading">
      <div class="container">
        <div class={`edition-section-head${talkPhoto ? ' edition-section-head--photo' : ''}`}>
          <div>
            <p class="edition-kicker" aria-hidden="true">{t.scheduleKicker}</p>
            <h2 id="schedule-heading" class="edition-heading">{t.scheduleHeading}</h2>
            <p class="edition-lead">{t.scheduleLead}</p>
            {t.timeZoneNote && <p class="edition-tz mono-label">{t.timeZoneNote}</p>}
          </div>
          {talkPhoto && (
            <figure class="edition-photo">
              <img src={talkPhoto.src} alt={talkPhoto.alt} loading="lazy" decoding="async" width="1536" height="864" />
            </figure>
          )}
        </div>

        <!-- カレンダー（日曜始まり） -->
        <div class="cal" role="group" aria-label={period}>
          <ol class="cal-head" role="list" aria-hidden="true">
            {t.weekdays.map(w => <li>{w}</li>)}
          </ol>
          {calendar.map(week => (
            <ol class="cal-week" role="list">
              {week.map(day =>
                day ? (
                  <li
                    class:list={['cal-day', { 'is-period': day.inPeriod, 'is-talk': day.talks.length > 0 }]}
                    data-cal-date={day.date}
                  >
                    <span class="cal-num">{day.day}</span>
                    {day.talks.map(talk => <span class="cal-time">{talk.start}</span>)}
                    {day.talks.length > 0 && !day.inPeriod && <span class="cal-outside">{t.outsidePeriod}</span>}
                  </li>
                ) : (
                  <li class="cal-day cal-day--blank" aria-hidden="true"></li>
                )
              )}
            </ol>
          ))}
          <p class="cal-legend mono-label">
            <span class="cal-legend-item cal-legend-item--period">{t.legendPeriod}</span>
            <span class="cal-legend-item cal-legend-item--talk">{t.legendTalk}</span>
          </p>
        </div>

        <!-- タイムテーブル -->
        <ol class="talk-list" role="list">
          {talks.map(talk => (
            <li class="talk" data-talk-start={talk.startIso} data-talk-end={talk.endIso} data-talk-date={talk.date}>
              <div class="talk-date">
                <span class="talk-month">{talk.month}</span>
                <span class="talk-day">{talk.day}</span>
                <span class="talk-weekday">{talk.weekday}</span>
              </div>
              <div class="talk-body">
                <span
                  class="talk-status mono-label"
                  data-talk-status
                  data-live={t.statusLive}
                  data-past={t.statusPast}
                  data-today={t.statusToday}
                  hidden
                ></span>
                <p class="talk-time">{talk.time}</p>
                <h3 class="talk-label">{talk.label}</h3>
                {talk.note && <p class="talk-note">{talk.note}</p>}
                {!talk.inPeriod && <p class="talk-note">{t.outsidePeriod}</p>}
                {world && (
                  <a href={world} target="_blank" rel="noopener noreferrer" class="talk-join mono-label">
                    {t.talkJoin} →
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- ================================================================
       Artists
       ================================================================ -->
  {artists.length > 0 && (
    <section id="artists" class="edition-section edition-section--tinted" aria-labelledby="artists-heading">
      <div class="container">
        <div class="edition-section-head">
          <div>
            <p class="edition-kicker" aria-hidden="true">{t.artistsKicker}</p>
            <h2 id="artists-heading" class="edition-heading">
              {t.artistsHeading}
              {t.artistsOrder && <span class="edition-heading-sub">（{t.artistsOrder}）</span>}
            </h2>
          </div>
        </div>

        <ul class="artist-grid" role="list">
          {artists.map(artist => {
            const inner = (
              <>
                <span class="artist-tile-media">
                  {artist.photo ? (
                    <img src={artist.photo} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <span class="artist-tile-initial" aria-hidden="true">{artist.initial}</span>
                  )}
                </span>
                <span class="artist-tile-name">{artist.name}</span>
                {artist.href && <span class="artist-tile-link mono-label">{t.artistPage} →</span>}
              </>
            );
            return (
              <li>
                {artist.href ? (
                  <a href={artist.href} class="artist-tile artist-tile--linked">{inner}</a>
                ) : (
                  <div class="artist-tile">{inner}</div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <!-- ================================================================
       How to join（VRChat の会場がある回だけ）
       ================================================================ -->
  {world && (
    <section id="howto" class="edition-section" aria-labelledby="howto-heading">
      <div class="container">
        <div class="edition-section-head">
          <div>
            <p class="edition-kicker" aria-hidden="true">{t.howtoKicker}</p>
            <h2 id="howto-heading" class="edition-heading">{t.howtoHeading}</h2>
          </div>
        </div>

        <ol class="howto-steps" role="list">
          {t.howtoSteps.map((step, i) => (
            <li class="howto-step">
              <span class="howto-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="howto-title">{step.title}</h3>
              <p class="howto-body">{fill(step.body, { search: worldSearch ?? title })}</p>
            </li>
          ))}
        </ol>

        <div class="howto-cta">
          <a href={world} target="_blank" rel="noopener noreferrer" class="btn btn-accent edition-cta">
            {t.enterButton}
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ================================================================
       Information — 開催概要と記録
       ================================================================ -->
  <section id="info" class={`edition-section${world ? ' edition-section--tinted' : ''}`} aria-labelledby="info-heading">
    <div class="container">
      <div class="edition-section-head">
        <div>
          <p class="edition-kicker" aria-hidden="true">{t.infoKicker}</p>
          <h2 id="info-heading" class="edition-heading">{t.infoHeading}</h2>
        </div>
      </div>

      <dl class="edition-facts">
        <div class="edition-fact">
          <dt class="mono-label">{t.period}</dt>
          <dd>{period}</dd>
        </div>
        <div class="edition-fact">
          <dt class="mono-label">{t.format}</dt>
          <dd>{d.format === 'hybrid' ? t.formatHybrid : t.formatVr}</dd>
        </div>
        <div class="edition-fact">
          <dt class="mono-label">{t.venue}</dt>
          <dd>
            <ul class="edition-venues" role="list">
              {venues.map(venue => (
                <li>
                  <span>{venue.name}</span>
                  {(venue.period || venue.hours) && (
                    <span class="edition-venue-meta">{[venue.period, venue.hours].filter(Boolean).join(' / ')}</span>
                  )}
                </li>
              ))}
            </ul>
          </dd>
        </div>
        {admission && (
          <div class="edition-fact">
            <dt class="mono-label">{t.admission}</dt>
            <dd>{admission}</dd>
          </div>
        )}
        {total && (
          <div class="edition-fact">
            <dt class="mono-label">{t.artists}</dt>
            <dd>{fill(t.artistCount, { n: total })}</dd>
          </div>
        )}
        {d.organizer && (
          <div class="edition-fact">
            <dt class="mono-label">{t.organizer}</dt>
            <dd>{pick(d.organizer, lang)}</dd>
          </div>
        )}
      </dl>

      {records.length > 0 && (
        <div class="edition-records-wrap">
          <p class="edition-records-heading mono-label">{t.records}</p>
          <ul class="edition-records" role="list">
            {records.map(record => (
              <li>
                <a href={record.href} class="edition-record">
                  <span>{record.label}</span>
                  <span class="edition-record-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {d.notice && <p class="edition-notice">{pick(d.notice, lang)}</p>}
    </div>
  </section>

  <!-- ================================================================
       回の前後と、企画全体のページへの導線
       ================================================================ -->
  <nav class="edition-pager" aria-label="ARTLINK">
    <div class="container edition-pager-inner">
      <a href={programHref} class="btn btn-outline">{t.backToProgram}</a>
      <div class="edition-pager-links">
        {older && (
          <a href={editionPath(lang, older)} class="edition-pager-link">
            <span class="mono-label">← {t.previous}</span>
            <span>{editionTitle(older)}</span>
          </a>
        )}
        {newer && (
          <a href={editionPath(lang, newer)} class="edition-pager-link edition-pager-link--next">
            <span class="mono-label">{t.next} →</span>
            <span>{editionTitle(newer)}</span>
          </a>
        )}
      </div>
    </div>
  </nav>
</BaseLayout>

<script>
  // 在廊の状態（本日・開催中・終了）は閲覧時刻で決まるので、ブラウザ側で付ける。
  // 静的 HTML には状態を書かない（ビルド時点で固定されて古くなるため）。JS が無くても表示は崩れない。
  const now = Date.now();
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo' }).format(new Date());

  document.querySelectorAll<HTMLElement>('[data-talk-start]').forEach(talk => {
    const start = Date.parse(talk.dataset.talkStart!);
    const end = Date.parse(talk.dataset.talkEnd!);
    const badge = talk.querySelector<HTMLElement>('[data-talk-status]');
    const state =
      now >= end ? 'past' : now >= start ? 'live' : talk.dataset.talkDate === today ? 'today' : undefined;
    if (!state || !badge) return;
    talk.classList.add(`is-${state}`);
    badge.textContent = badge.dataset[state] ?? '';
    badge.hidden = false;
  });

  document.querySelectorAll<HTMLElement>(`[data-cal-date="${today}"]`).forEach(day => day.classList.add('is-today'));
</script>

<style>
  /* ================================================================
     Hero
     ================================================================ */
  .edition-kv-section {
    background: #000;
    border-bottom: 1px solid var(--color-border-accent);
  }

  .edition-kv-frame {
    max-width: 1600px;
    margin-inline: auto;
  }

  .edition-kv {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    display: block;
  }

  .edition-hero {
    padding-block: var(--space-12) var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }

  .edition-hero--with-kv {
    background:
      radial-gradient(ellipse at 15% 0%, var(--color-main-glow) 0%, transparent 55%),
      var(--color-bg);
  }

  .edition-hero-layout {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .edition-eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .edition-program-link {
    color: var(--color-main);
    border-bottom: 1px solid var(--color-border-bright);
  }

  .edition-program-link:hover {
    color: var(--color-main-light);
    border-color: var(--color-main);
    text-decoration: none;
  }

  .edition-title {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 200;
    letter-spacing: var(--tracking-widest);
    line-height: 1.05;
    margin-bottom: var(--space-4);
  }

  .edition-period {
    font-size: var(--text-xl);
    font-weight: 300;
    letter-spacing: var(--tracking-wide);
    color: var(--color-main);
    margin-bottom: var(--space-6);
  }

  .edition-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .edition-chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-main);
    border: 1px solid var(--color-border-bright);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
  }

  .edition-chip--accent {
    color: var(--color-text-on-accent);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .edition-hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .edition-cta {
    padding-inline: var(--space-12);
    box-shadow: var(--glow-accent);
  }

  .edition-summary {
    margin-top: var(--space-8);
    font-size: var(--text-base);
    line-height: 2;
    color: var(--color-text-muted);
    max-width: var(--content-width);
  }

  .edition-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 6;
    overflow: hidden;
  }

  .edition-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.65) saturate(0.85);
  }

  .edition-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--color-bg) 0%, transparent 20%, transparent 80%, var(--color-bg) 100%);
    pointer-events: none;
  }

  /* ================================================================
     ページ内ナビ
     ================================================================ */
  .edition-tabs {
    position: sticky;
    top: var(--nav-height);
    z-index: 50;
    background: rgba(5, 11, 10, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
  }

  .edition-tabs-list {
    list-style: none;
    display: flex;
    gap: var(--space-8);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .edition-tabs-list a {
    display: block;
    padding-block: var(--space-4);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .edition-tabs-list a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* ================================================================
     セクション共通
     ================================================================ */
  .edition-section {
    padding-block: var(--space-24);
    border-bottom: 1px solid var(--color-border);
    /* sticky なヘッダとページ内ナビの下に見出しが隠れないように */
