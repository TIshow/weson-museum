---
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_META,
  localizedPath,
  stripLocale,
  type Locale,
} from '@i18n/config';
import { useTranslations } from '@i18n/ui';
import { resolveOgImage } from '@lib/og';

interface Props {
  title: string;
  description: string;
  descriptionEn?: string;
  ogImage?: string;
  /** サムネイルの代替テキスト。省略時は既定の文言 */
  ogImageAlt?: string;
  lang?: Locale;
}

const { title, description, descriptionEn, ogImage, ogImageAlt, lang = DEFAULT_LOCALE } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// 実在しない・SNS が表示できない形式の画像はビルドで落とす（lib/og.ts）
const og = resolveOgImage(ogImage, Astro.site!, ogImageAlt ?? useTranslations(lang).common.ogImageAlt);

// hreflang と og:locale:alternate は LOCALES から生成する。言語を足せば自動で増える。
const canonicalPath = stripLocale(Astro.url.pathname);
const alternates = LOCALES.map(locale => ({
  locale,
  href: new URL(localizedPath(locale, canonicalPath), Astro.site).toString(),
}));
const defaultHref = alternates.find(a => a.locale === DEFAULT_LOCALE)!.href;
const ogLocale = LOCALE_META[lang].ogLocale;

// JSON-LD: Organization + VirtualLocation schema (English for international indexing)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://weson-museum.com/#organization',
      name: 'WESON MUSEUM',
      url: 'https://weson-museum.com/',
      sameAs: [
        'https://x.com/WESON_MUSEUM',
        'https://www.instagram.com/weson_museum/',
        'https://weson-museum.booth.pm/',
      ],
      description:
        'WESON MUSEUM is a virtual reality art museum on VRChat, offering permanent exhibitions and the annual ARTLINK group show. Open to visitors worldwide regardless of location.',
    },
    {
      '@type': 'Museum',
      '@id': 'https://weson-museum.com/#museum',
      name: 'WESON MUSEUM',
      alternateName: ['ウェソンミュージアム', 'VR美術館'],
      url: 'https://weson-museum.com/',
      description:
        'A virtual reality art museum built in VRChat. Featuring four permanent galleries — Sky, Palau, Forest, and Rain — plus the annual ARTLINK exhibition connecting artists and audiences across borders.',
      keywords: [
        'VR art museum', 'virtual reality museum', 'VRChat museum',
        'ARTLINK', 'metaverse art', 'Japanese contemporary art',
        'Palau art', 'VR gallery', 'online art exhibition',
        'VR美術館', 'バーチャル美術館', 'メタバース美術展',
      ],
      event: {
        '@type': 'Event',
        name: 'VR Gallery Tour',
        description: 'Weekly guided tour of WESON MUSEUM galleries. Every Saturday 21:00–22:00 JST on VRChat. Free entry, open to all.',
        eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
        location: {
          '@type': 'VirtualLocation',
          url: 'https://vrchat.com',
        },
        organizer: {
          '@id': 'https://weson-museum.com/#organization',
        },
        schedule: {
          '@type': 'Schedule',
          repeatFrequency: 'P1W',
          byDay: 'https://schema.org/Saturday',
          startTime: '21:00',
          endTime: '22:00',
        },
      },
    },
  ],
};
---

<!-- charset & viewport -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Google Search Console verification -->
<meta name="google-site-verification" content="6NBweMLOMqPeVh5ouq7nTC1yhUg_MGxGMTO5vXIjRkI" />

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />

<!-- hreflang: 対応ロケール分を自動生成 -->
{alternates.map(alt => <link rel="alternate" hreflang={alt.locale} href={alt.href} />)}
<link rel="alternate" hreflang="x-default" href={defaultHref} />

<!-- Primary Meta -->
<title>{title}</title>
<meta name="description" content={description} />
{descriptionEn && <meta name="description" lang="en" content={descriptionEn} />}

<!-- テーマカラー -->
<meta name="theme-color" content="#050b0a" />

<!-- Open Graph (Japanese) -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={og.url} />
{og.type && <meta property="og:image:type" content={og.type} />}
{og.width && <meta property="og:image:width" content={String(og.width)} />}
{og.height && <meta property="og:image:height" content={String(og.height)} />}
<meta property="og:image:alt" content={og.alt} />
<meta property="og:site_name" content="WESON MUSEUM" />
<meta property="og:locale" content={ogLocale} />
{LOCALES.filter(l => l !== lang).map(l => (
  <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
))}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@WESON_MUSEUM" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={descriptionEn ?? description} />
<meta name="twitter:image" content={og.url} />
<meta name="twitter:image:alt" content={og.alt} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
<link rel="apple-touch-icon" href={`${base}favicon.svg`} />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- JSON-LD structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
