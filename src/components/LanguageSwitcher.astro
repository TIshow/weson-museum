---
import {
  LOCALES,
  LOCALE_META,
  getLangFromUrl,
  localizedPath,
  stripLocale,
} from '@i18n/config';
import { useTranslations } from '@i18n/ui';

// ロケールは LOCALES から生成する。言語を足してもこのファイルは触らなくてよい。
const current = getLangFromUrl(Astro.url);
const t = useTranslations(current);
const canonicalPath = stripLocale(Astro.url.pathname);

const options = LOCALES.map(locale => ({
  locale,
  meta: LOCALE_META[locale],
  href: localizedPath(locale, canonicalPath),
  isActive: locale === current,
}));
---

<nav class="lang-switcher" aria-label={t.common.langAria}>
  {options.map(({ locale, meta, href, isActive }, i) => (
    <>
      {i > 0 && <span class="lang-sep" aria-hidden="true">|</span>}
      <a
        href={href}
        class={`lang-btn${isActive ? ' lang-btn--active' : ''}`}
        lang={meta.htmlLang}
        hreflang={locale}
        aria-current={isActive ? 'true' : undefined}
      >{meta.label}</a>
    </>
  ))}
</nav>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .lang-btn {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-subtle);
    text-decoration: none;
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition: all var(--transition-fast);
  }

  .lang-btn:hover {
    color: var(--color-main);
    border-color: var(--color-border-bright);
    text-decoration: none;
  }

  .lang-btn--active {
    color: var(--color-main);
    border-color: var(--color-border-bright);
    background: var(--color-bg-glass);
  }

  .lang-sep {
    color: var(--color-border-bright);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
</style>
