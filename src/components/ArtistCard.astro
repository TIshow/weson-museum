---
interface Props {
  href: string;
  name: string;
  image?: string;
  based?: string;
  disciplines?: string[];
  vrResidency?: boolean;
  vrLabel: string;
}

const { href, name, image, based, disciplines = [], vrResidency = false, vrLabel } = Astro.props;
---

<li class="artist-card">
  <a href={href} class="artist-card-link">
    <div class="artist-card-media">
      {image ? (
        <img src={image} alt={name} loading="lazy" decoding="async" class="artist-card-img" />
      ) : (
        <div class="artist-card-placeholder" aria-hidden="true"></div>
      )}
      {vrResidency && <span class="artist-card-vr mono-label">{vrLabel}</span>}
    </div>

    <div class="artist-card-body">
      <h3 class="artist-card-name">{name}</h3>
      {based && <p class="artist-card-based mono-label">{based}</p>}
      {disciplines.length > 0 && (
        <ul class="artist-card-tags" role="list">
          {disciplines.map(d => <li class="tag">{d}</li>)}
        </ul>
      )}
    </div>
  </a>
</li>

<style>
  .artist-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-1);
    transition: border-color var(--transition-base), box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .artist-card:hover {
    border-color: var(--color-border-bright);
    box-shadow: var(--shadow-panel), var(--glow-main);
    transform: translateY(-2px);
  }

  .artist-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .artist-card-link:hover {
    text-decoration: none;
    color: inherit;
  }

  .artist-card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-2);
  }

  .artist-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.8) saturate(0.9);
    transition: filter var(--transition-slow), transform var(--transition-slow);
  }

  .artist-card:hover .artist-card-img {
    filter: brightness(1) saturate(1);
    transform: scale(1.03);
  }

  .artist-card-placeholder {
    width: 100%;
    height: 100%;
    background:
      linear-gradient(135deg, var(--color-bg-2) 0%, var(--color-bg-1) 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .artist-card-vr {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    color: var(--color-text-on-accent);
    background: var(--color-accent);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
  }

  .artist-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
  }

  .artist-card-name {
    font-size: var(--text-lg);
    font-weight: 300;
    letter-spacing: var(--tracking-wide);
    line-height: 1.4;
  }

  .artist-card:hover .artist-card-name {
    color: var(--color-main-light);
  }

  .artist-card-based {
    color: var(--color-text-subtle);
  }

  .artist-card-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
</style>
